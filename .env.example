# GEMINI_API_KEY: Required for Gemini AI API calls if used server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Python FastAPI backend endpoint URL
VITE_API_BASE_URL="http://localhost:8000"

# VITE_DEFAULT_MODE: 'demo' for local simulation or 'fastapi' for live Python FastAPI backend
VITE_DEFAULT_MODE="demo"
